<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    inheritInChildApplications="false" prevents this site's aspNetCore handler
    settings from being inherited by the /api sub-application (TSPMaster.API).
    Without this, IIS tries to run TSPMaster.Client.dll for /api/* requests.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\TSPMaster.Client.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
