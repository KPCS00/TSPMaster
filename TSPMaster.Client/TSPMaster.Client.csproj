<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>.\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
    <UserSecretsId>tspmaster-client-secrets</UserSecretsId>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Prevent satellite resource language folders (e.g. cs, de, es, fr, it, ja, ko, pl, pt-BR, ru, tr, zh-Hans, zh-Hant) from being copied -->
  <Target Name="RemoveSatelliteAssemblies" BeforeTargets="PrepareForPublish;Build">
    <ItemGroup>
      <ResourceLanguage Remove="@(ResourceLanguage)" Condition="'%(ResourceLanguage.Identity)' != 'en'" />
      <IntermediateSatelliteAssembliesWithTargetPath Remove="@(IntermediateSatelliteAssembliesWithTargetPath)" />
      <ReferenceSatellitePaths Remove="@(ReferenceSatellitePaths)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveSatelliteAssembliesFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFilesToPublish Remove="@(ResolvedFilesToPublish)" Condition="'%(ResolvedFilesToPublish.Culture)' != '' And '%(ResolvedFilesToPublish.Culture)' != 'en'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Remove="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. Please download it from https://nodejs.org/" />
    <Message Importance="high" Text="Restoring dependencies using 'npm'..." />
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <Target Name="BuildClientAssets" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' Or '$(BuildingForPublish)' == 'true'">
    <Message Importance="high" Text="Building SPA assets with Vite..." />
    <Exec Command="npm install" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>
