<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Pass ASP.NET Core error responses through unchanged — prevents IIS from
           replacing 4xx/5xx responses with its own HTML error pages. -->
      <httpErrors existingResponse="PassThrough" />
      <handlers>
        <!-- <clear /> prevents inheriting the parent site's aspNetCore handler
             registration, which would cause a duplicate handler conflict. -->
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="outofprocess" must match the client app (tspmaster.com) since both
        apps share the same IIS app pool on site4now.net. Mixing hosting models in the
        same pool causes HTTP 500.34.
      -->
      <aspNetCore processPath="dotnet" arguments=".\TSPMaster.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
