<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Pass ASP.NET Core error responses through unchanged -->
      <httpErrors existingResponse="PassThrough" />
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <!-- Remove IIS default handlers that intercept OPTIONS preflight requests -->
        <remove name="WebDAV" />
        <remove name="OPTIONSVerbHandler" />
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\TSPMaster.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>

