<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!--
      hostingModel="outofprocess" must match the client app (tspmaster.com) since both
      apps share the same IIS app pool on site4now.net. Mixing hosting models in the
      same pool causes HTTP 500.34.
    -->
    <aspNetCore processPath="dotnet" arguments=".\TSPMaster.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
  </system.webServer>
</configuration>
