<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TSPMaster.API</RootNamespace>
    <AssemblyName>TSPMaster.API</AssemblyName>
    <UserSecretsId>tspmaster-api-secrets</UserSecretsId>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Prevent satellite resource language folders (e.g. cs, de, es, fr, it, ja, ko, pl, pt-BR, ru, tr, zh-Hans, zh-Hant) from being copied -->
  <Target Name="RemoveSatelliteAssemblies" BeforeTargets="PrepareForPublish;Build">
    <ItemGroup>
      <ResourceLanguage Remove="@(ResourceLanguage)" Condition="'%(ResourceLanguage.Identity)' != 'en'" />
      <IntermediateSatelliteAssembliesWithTargetPath Remove="@(IntermediateSatelliteAssembliesWithTargetPath)" />
      <ReferenceSatellitePaths Remove="@(ReferenceSatellitePaths)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveSatelliteAssembliesFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFilesToPublish Remove="@(ResolvedFilesToPublish)" Condition="'%(ResolvedFilesToPublish.Culture)' != '' And '%(ResolvedFilesToPublish.Culture)' != 'en'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- EF Core + SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ASP.NET Core Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <!-- JWT Bearer Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- AWS SES -->
    <PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.401" />
    <!-- NLog -->
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.4.0" />
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
    <!-- CSV parsing -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <!-- Microsoft.Extensions.Http is included in the ASP.NET Core shared framework -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TSPMaster.Client\TSPMaster.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
